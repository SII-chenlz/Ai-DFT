# Copy this file to .env.local for local testing. Never commit .env.local.
# The Harness reads DEEPSEEK_API_KEY; the AIFS scripts read the AIFS_* values.

DEEPSEEK_API_KEY=
# Optional; defaults to the public DeepSeek API endpoint in Harness.
DEEPSEEK_BASE_URL=

# Use the real REST basis-set pool when available. The local start script uses
# .local/basis_set_pool if this is empty; that is enough to test card rendering,
# but not enough to run a REST calculation.
AIFS_BASIS_SET_POOL=
AIFS_BACKEND_URL=http://127.0.0.1:8000
AIFS_BACKEND_HOST=127.0.0.1
AIFS_BACKEND_PORT=8000

# Keep Harness state isolated from the user's normal profiles during testing.
DSH_HOME=
