# AIFS backend deployment configuration.
# Copy to .env and adjust for your deployment. Never commit .env.
#
# Root path of the deployed REST basis set pool. The deployment layer injects
# this value into RestInputRequest.basis_set_pool; rendered input cards use
# basis_path = {basis_set_pool}/{basis}, so no machine-local path is ever
# hardcoded by the backend.
AIFS_BASIS_SET_POOL=/path/to/rest/basis_sets
