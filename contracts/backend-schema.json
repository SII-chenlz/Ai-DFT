        "system_name": {
          "title": "System Name",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "string"
        },
        "position_unit": {
          "default": "angstrom",
          "enum": [
            "angstrom",
            "bohr"
          ],
          "title": "Position Unit",
          "type": "string"
        },
        "job_type": {
          "enum": [
            "energy",
            "opt",
            "force",
            "numerical dipole"
